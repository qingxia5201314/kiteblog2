# --- Hexo generated / runtime state ---------------------------------------
db.json
public/
.deploy_git/
.deploy*/
_multiconfig.yml

# --- Dependencies ----------------------------------------------------------
node_modules/

# --- Local build + tool caches (53 MB of npm cache lives here) -------------
operations/cache/
operations/logs/
operations/test-artifacts/
operations/publish.lock
operations/withdrawn/
operations/release.yml
operations/config-before-admin.yml
operations/hexo-admin-api.before-*.js

# --- OS / editor noise -----------------------------------------------------
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
*~
.idea/
.vscode/

# --- Content lives in its own repository ---------------------------------
# On the VPS `source` is a symlink to /opt/kitepop-content/source, which is a
# separate git repo the deploy pipeline never resets. Posts must not be tracked
# here: this repo is public and CI runs `git reset --hard` on every deploy.
# No trailing slash on purpose -- `/source/` only matches a real directory and
# would leave the symlink showing up in `git status`.
/source

# --- local operational scratch -------------------------------------------
.gitignore.bak-before-git-init

# local safety copies produced during one-off repairs
operations/*.bak-*
themes/arknights.bak-*
